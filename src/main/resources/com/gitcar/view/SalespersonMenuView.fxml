<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gitcar.app.controllers.SalespersonMenuController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Arquivo">
            <items>
              <MenuItem fx:id="logoutMenuItem" mnemonicParsing="false" onAction="#handleLogout" text="Logout" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Ajuda">
            <items>
              <MenuItem fx:id="aboutMenuItem" mnemonicParsing="false" onAction="#handleAbout" text="Sobre" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <left>
      <VBox prefHeight="575.0" prefWidth="180.0" spacing="10.0" style="-fx-background-color: #f0f0f0; -fx-padding: 10;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Menu Vendedor" />
            <Button fx:id="sellVehicleButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSellVehicle" text="Vender Veículo" />
            <Button fx:id="salesHistoryButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSalesHistory" text="Histórico de Vendas" />
            <Button fx:id="scheduleTestDriveButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleScheduleTestDrive" text="Agendar Test-Drive" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <Pane fx:id="contentArea" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <!-- Content from sub-screens will be loaded here -->
         <children>
            <Label layoutX="20.0" layoutY="20.0" text="Bem-vindo! Selecione uma opção no menu à esquerda." />
         </children>
      </Pane>
   </center>
   <bottom>
      <Label fx:id="statusBarLabel" text="Usuário: [email_placeholder]" BorderPane.alignment="CENTER_LEFT">
         <padding>
            <Insets bottom="5.0" left="10.0" right="5.0" top="5.0" />
         </padding>
      </Label>
   </bottom>
</BorderPane>

